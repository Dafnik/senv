{
  "name": "@senv/source",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "vp run -r --parallel dev",
    "dev": "vp run -r --parallel dev",
    "build": "vp run -r build",
    "lint": "vp lint",
    "test": "vp test run && vp run @senv/app#test",
    "check": "vp check && vp run fmt:angular:check",
    "fmt": "vp fmt && vp run fmt:angular",
    "fmt:angular": "vp run @senv/app#fmt",
    "fmt:angular:check": "vp run @senv/app#fmt:check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "auth:generate": "vp run @senv/api#auth:generate"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.0",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.11",
    "typescript": "6.0.3",
    "vite-plus": "1.0.0"
  },
  "engines": {
    "node": "24.20.0"
  },
  "packageManager": "pnpm@11.22.0"
}

{
  "name": "@senv/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#*": "./*"
  },
  "scripts": {
    "dev": "cd ../.. && NODE_ENV=development nitro dev apps/api",
    "preview": "cd ../.. && node --env-file-if-exists=.env dist/apps/api/server/index.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "auth:generate": "cd ../.. && auth generate --yes --config apps/api/server/features/auth/auth.config.ts --output drizzle/auth-schema.generated.ts"
  },
  "dependencies": {
    "@trpc/server": "11.18.0",
    "better-auth": "1.6.30",
    "busboy": "^1.6.0",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.3",
    "nanoid": "6.0.1",
    "nodemailer": "10.0.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-email": "6.11.0",
    "superjson": "2.2.6",
    "tar-stream": "^3.2.1",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "auth": "1.6.30",
    "nitro": "3.0.260903-beta"
  }
}

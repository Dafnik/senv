DATABASE_URL=file:./data/senv.sqlite

# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=

API_URL=http://localhost:3000
APP_URL=http://localhost:4200
APP_DOMAIN=localhost
ROOT_DOMAIN=localhost

# Local nitro dev captures invitation emails at GET /api/notifications.
# Production email delivery requires both values:
# SMTP_URL=smtps://username:password@smtp.example.com:465
# EMAIL_FROM=senv <noreply@example.com>
